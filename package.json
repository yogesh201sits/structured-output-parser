{
  "name": "structured-output-parser",
  "version": "0.1.0",
  "description": "A lightweight Zod-based structured output parser for LLM responses.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "example:groq": "bun run examples/groq.ts",
    "example:groq-markdown": "bun run examples/groq-markdown.ts"
  },
  "dependencies": {
    "zod": "^3.0.0",
    "zod-to-json-schema": "^3.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^26.6.2",
    "groq-sdk": "^1.6.0",
    "typescript": "^7.0.0"
  },
  "engines": {
    "bun": ">=1.3.0",
    "node": ">=20"
  }
}
